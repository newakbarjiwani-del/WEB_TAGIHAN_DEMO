APP_NAME="DEMO_WS_TAGIHAN_CICCILAN"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=

TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_ENABLED=false

WS_TAGIHAN_URL=http://103.23.103.43/WEB_TAGIHAN_PROJECT/DEMO_WS_TAGIHAN_CICILAN/index.php

# Brand / white-label (master project) — copy ke .env untuk override
BRAND_NAME="DEMO_WS_TAGIHAN_CICCILAN"
BRAND_SHORT_NAME="Demo Cicilan"
BRAND_TAGLINE="Cek & bayar tagihan"
BRAND_DESCRIPTION="Demo cek dan bayar tagihan cicilan"
BRAND_LOGO=logo.jpeg
BRAND_FAVICON=icon-jannah.jpeg
BRAND_ICON_192=icons/icon-192.png
BRAND_ICON_512=icons/icon-512.png
BRAND_GUIDE_IMAGE=Gambar_Panduan_Bayar.jpeg
BRAND_GUIDE_PDF=Booklet_Panduan_Bayar.pdf
BRAND_SHOW_GUIDE=true
# Model bayar: 1=bills (pilih tagihan+VA), 2=saldo (tagihan info saja, VA kartu isi saldo) — default 2
BRAND_PAYMENT_MODEL=2
BRAND_PAYMENT_QRIS=false
QRIS_SERVER_URL=http://103.23.103.43/qris/lazizmu_diy/server.php
QRIS_JWT_SECRET=TokenJWT_BMI_ICT
QRIS_ACCOUNT_NO=5080010295
QRIS_MITRA_CUSTOMER_ID="ISLAMIC CENTER SMG451061"
QRIS_TIPE_TRANSAKSI=MTR-GENERATE-QRIS-DYNAMIC
BRAND_COLOR_PRIMARY="#0B7EB8"
BRAND_COLOR_PRIMARY_HOVER="#086693"
BRAND_COLOR_PRIMARY_SOFT="#D6EEF8"
BRAND_COLOR_THEME="#0B7EB8"
BRAND_COLOR_HIGHLIGHT="#E89B0C"
BRAND_COLOR_HIGHLIGHT_SOFT="#FFF3D1"
BRAND_RADIUS=8
BRAND_PWA_ENABLED=true

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=10080

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_APP_NAME="${APP_NAME}"
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
